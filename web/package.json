{
  "name": "bcb-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build:wasm": "make -C ../wasm",
    "check:simd": "make -C ../wasm check-simd",
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "bench": "node scripts/bench.ts",
    "preview": "vite preview",
    "serve:nginx": "docker compose -f ../deploy/docker-compose.yml up",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "wasm-feature-detect": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@webgpu/types": "^0.1.74",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
